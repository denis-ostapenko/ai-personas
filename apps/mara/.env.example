# Copy to .env and supply your own OpenAI API key.
OPENAI_API_KEY=
PORT=4351
# Used only when creating profiles. Existing profiles keep their own model.
MARA_MODEL=gpt-6.1-sol
MARA_REASONING=low
# Default file: data/personas.sqlite
# EVOLVING_DB=
# Initial total request limit for a new database (1-200).
EVOLVING_MAX_CALLS=60
# Optional local embedding interpreter and model cache.
# MARA_EMBED_PYTHON=
# MARA_EMBED_CACHE=
